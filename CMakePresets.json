{
  "version": 3,
  "configurePresets": [
    {
      "name": "quality-defaults",
      "hidden": true,
      "cacheVariables": {
        "ENGINE_ENABLE_STRICT_WARNINGS": "ON",
        "ENGINE_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "quality-sanitizers",
      "hidden": true,
      "cacheVariables": {
        "ENGINE_ENABLE_ASAN": "ON",
        "ENGINE_ENABLE_UBSAN": "ON"
      }
    },
    {
      "name": "vcpkg-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "system-deps-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_MODULE_PATH": "${sourceDir}/cmake"
      }
    },
    {
      "name": "ninja-relwithdebinfo",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-vs2022",
      "hidden": true,
      "inherits": [
        "quality-defaults",
        "vcpkg-base"
      ],
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "vs2022-vulkan",
      "displayName": "Windows (VS 2022 + vcpkg + Vulkan)",
      "inherits": "windows-vs2022",
      "cacheVariables": {
        "ENGINE_ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "vs2022-cuda",
      "displayName": "Windows (VS 2022 + vcpkg + CUDA)",
      "description": "实验性预设：启用 CUDA compute sidecar 加速粒子和流体管线。",
      "inherits": "windows-vs2022",
      "cacheVariables": {
        "ENGINE_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "vs2022-benchmark",
      "displayName": "Windows (VS 2022 + Vulkan + CUDA Benchmark)",
      "description": "本地论文实验预设：同时编译 OpenGL、Vulkan Compute 与 CUDA Sidecar，不用于 CI。",
      "inherits": "windows-vs2022",
      "binaryDir": "${sourceDir}/build-benchmark",
      "environment": {
        "VULKAN_SDK": "C:/Dev/Environments/VulkanSDK/1.4.341.1"
      },
      "cacheVariables": {
        "ENGINE_ENABLE_VULKAN": "ON",
        "ENGINE_ENABLE_CUDA": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Windows (VS 2022 + vcpkg)",
      "description": "默认 Windows 开发/CI 预设：启用严格 warning 与 warnings-as-errors。",
      "inherits": "windows-vs2022"
    },
    {
      "name": "linux-default",
      "displayName": "Linux (Ninja + vcpkg)",
      "description": "Linux CI 预设：vcpkg + RelWithDebInfo + 严格 warning。",
      "inherits": [
        "quality-defaults",
        "vcpkg-base",
        "ninja-relwithdebinfo"
      ]
    },
    {
      "name": "linux-sanitize",
      "displayName": "Linux (Ninja + vcpkg + ASAN/UBSAN)",
      "description": "Linux 质量门槛预设：AddressSanitizer + UndefinedBehaviorSanitizer。",
      "inherits": [
        "quality-defaults",
        "quality-sanitizers",
        "vcpkg-base",
        "ninja-relwithdebinfo"
      ]
    },
    {
      "name": "linux-system",
      "displayName": "Linux (Ninja, system deps)",
      "description": "Linux 编译验证预设：使用系统 FFmpeg/OpenAL，启用严格 warning。",
      "inherits": [
        "quality-defaults",
        "system-deps-base",
        "ninja-relwithdebinfo"
      ]
    },
    {
      "name": "macos-default",
      "displayName": "macOS (Ninja, system deps)",
      "description": "macOS CI 预设：仅做编译验证；运行时仍受 OpenGL 4.1 上限约束。",
      "inherits": [
        "quality-defaults",
        "system-deps-base",
        "ninja-relwithdebinfo"
      ]
    },
    {
      "name": "clion-debug",
      "displayName": "CLion (Ninja + vcpkg + Debug)",
      "description": "CLion 调试预设：Debug + 严格 warning。",
      "inherits": [
        "quality-defaults",
        "vcpkg-base"
      ],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "warnings": {
        "dev": false
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clion-release",
      "displayName": "CLion (Ninja + vcpkg + RelWithDebInfo)",
      "description": "CLion 发布预设：RelWithDebInfo + 严格 warning。",
      "inherits": [
        "quality-defaults",
        "vcpkg-base"
      ],
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "warnings": {
        "dev": false
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ]
}
